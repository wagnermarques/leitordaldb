{
  "name": "leitordaldb",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "fzl-fund-ui/packages/*",
    "fzl-fund-ui/webcomponents-es6",
    "fzl-fund-ui/webcomponents-lit",
    "fzl-fund-ui/webcomponents-angular",
    "fzl-fund-ui/appshell-lit"
  ],
  "scripts": {
    "dados": "python3 scripts/gerar-dados-ldb.py",
    "build:ui": "npm run build --workspace=@fzl/design-tokens --if-present && npm run build --workspace=@fzl/webcomponents-lit --if-present",
    "predev": "npm run build:ui",
    "dev": "vite",
    "prebuild": "npm run build:ui",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "npm run build && npm run preview"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@material-symbols/font-400": "^0.47.1",
    "@material/web": "^2.5.0",
    "fzl-fund-appshell--lit": "*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.4",
    "typescript": "~5.5.4",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
